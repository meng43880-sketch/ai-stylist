# 1. Copy .env.example to .env
# 2. Insert API keys
# 3. Start backend
# 4. Start frontend (served by backend)

# --- AI gateway (OpenAI-совместимый; приоритет у явных QWEN_*_KEY) ---
OFOX_API_KEY=
OFOX_BASE_URL=https://api.ofox.ai/v1

# --- ZVENO: только платные модели (free-tier без мощности) ---
ZVENO_API_KEY=
ZVENO_BASE_URL=https://api.zveno.ai/v1
ZVENO_MODEL=mistralai/mistral-nemo
ZVENO_FALLBACKS=
# Три модели под задачи (перекрывают ZVENO_MODEL точечно):
# QWEN_STYLIST_MODEL=mistralai/mistral-nemo
# QWEN_PRODUCT_MODEL=mistralai/mistral-nemo
# QWEN_VISION_MODEL=google/gemma-3-4b-it

# --- AI: Vision (анализ фото; задаётся env, не хардкод) ---
QWEN_VISION_API_KEY=
QWEN_VISION_BASE_URL=
QWEN_VISION_MODEL=qwen/qwen3.8-flash

# --- AI: Main Stylist (диалог, сложные решения) ---
QWEN_STYLIST_API_KEY=
QWEN_STYLIST_BASE_URL=
QWEN_STYLIST_MODEL=qwen/qwen3.8-flash

# --- AI: Product (дешёвый анализ товаров и отзывов) ---
QWEN_PRODUCT_API_KEY=
QWEN_PRODUCT_BASE_URL=
QWEN_PRODUCT_MODEL=qwen/qwen-flash

# --- Self-hosted GPU (будущее): те же провайдеры, другой BASE_URL ---
# QWEN_STYLIST_BASE_URL=http://gpu-local:8000/v1
# QWEN_STYLIST_MODEL=qwen3-32b-awq

# --- Demo mode: true = работа без ключей (DemoAI + демо-каталог) ---
DEMO_MODE=true

# --- Data source: demo | hybrid (демо + живые товары WB) ---
DATA_SOURCE=demo

# --- Marketplaces (backend-proxy; ключи только здесь) ---
WILDBERRIES_API_KEY=
OZON_API_KEY=

# --- Weather (Open-Meteo — ключ не нужен; координаты для погоды) ---
WEATHER_LAT=55.75
WEATHER_LON=37.61
WEATHER_CITY=Москва

# --- Scoring weights (8 факторов; нормируются к сумме 1) ---
# SCORE_WEIGHTS={"style":0.25,"color":0.15,"body":0.15,"size":0.15,"budget":0.10,"pref":0.10,"quality":0.05,"season":0.05}

# --- Limits ---
PORT=8001
MAX_BODY_BYTES=1500000
MAX_IMAGE_BYTES=4000000
RATE_PER_MIN=60

# --- App ---
NODE_ENV=development
